          "void main\\(PIX_PARAMS\\)[\\s\\S]*\\z",
          "void main(PIX_PARAMS)\r\n{\r\n    // IranCoJ Edition: the snapshot behind in-game menus, blurred and darkened (it was sepia paper).\r\n    FLOAT2 uv = V_UV_0_TC.xy;\r\n    FLOAT4 sum = 0;\r\n    for (int x = -3; x <= 3; x++)\r\n        for (int y = -3; y <= 3; y++)\r\n            sum += Sample(s_screen, uv + FLOAT2(x * 0.0035, y * 0.0062));\r\n    FLOAT3 c = sum.rgb / 49.0;\r\n    c = lerp(Luminance_Equal(c).xxx, c, 0.8) * 0.6;\r\n    OUT.v_clr = FLOAT4(c, 1.0);\r\n\r\n    #if defined(ALPHA_BLEND_ON)\r\n        OUT.v_clr.a = CONST_0.w;\r\n    #endif\r\n}\r\n"
        ]
      ]
