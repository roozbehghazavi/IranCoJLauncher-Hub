{
  "version": "0.3.0",
  "notes": "E1b, modelled on Golden Mod MP 1.0: every map is also inside Data0/1/2.pak, so the .rpack load caches are left out except the four common ones. Single-player music and menu videos are left out; MenuBackgroundFilms.scr is rewritten so every menu slot plays MenuMovie_0. Test every multiplayer map after changing this list. E3: MenuMain.xui is rewritten from the player's Data0.pak to hide Single player and Extra content; with menu_main.rpack left out the game reads the loose .xui.",
  "exclude": [
    "DirectX/**",
    "Redist/**",
    "unins*",
    "goggame-*",
    "gog.ico",
    "support.ico",
    "webcache.zip",
    "**/*.lnk",
    "CoJ2/Out/**",
    "tutorials/**",
    "ChromEdShortTutorial.pdf",
    "Editor_x86.exe",
    "Plugins_x86/**",
    "shadercache/**",
    "CoJ2/Data/*.rpack",
    "CoJ2/Data/Music/**",
    "CoJ2/Data/Menu/Movies/*.wmv"
  ],
  "keep": [
    "CoJ2/Data/common_mp_anims.rpack",
    "CoJ2/Data/common_mp_meshes.rpack",
    "CoJ2/Data/common_mp_textures.rpack",
    "CoJ2/Data/common_sp_anims.rpack",
    "CoJ2/Data/Music/COJ2_New_Menu.ogg",
    "CoJ2/Data/Music/COJ2_MultiP_*",
    "CoJ2/Data/Music/COJ2_Multi_*",
    "CoJ2/Data/Music/COJ2_Conc_Mode_4.ogg",
    "CoJ2/Data/Menu/Movies/MenuMovie_0.wmv",
    "CoJ2/Data/Menu/Movies/Initial_BG.wmv",
    "CoJ2/Data/Menu/Movies/Ubisoft_720p*.wmv"
  ],
  "rewrite": [
    {
      "path": "CoJ2/Data/Menu/MenuBackgroundFilms.scr",
      "pak": "CoJ2/Data0.pak",
      "entry": "Data/Menu/MenuBackgroundFilms.scr",
      "replace": [
        [
          "MenuMovie_[1-9]",
          "MenuMovie_0"
        ]
      ]
    },
    {
      "path": "CoJ2/Data/Menu/scr/MenuMain.xui",
      "pak": "CoJ2/Data0.pak",
      "entry": "Data/Menu/scr/MenuMain.xui",
      "replace": [
        [
          "(<Id>B_Singleplayer</Id>(?:(?!</Properties>)[\\s\\S])*?</Position>)",
          "$1\r\n<Show>false</Show>"
        ],
        [
          "(<Id>B_Singleplayer</Id>(?:(?!</Properties>)[\\s\\S])*?</Visual>)",
          "$1\r\n<Enabled>false</Enabled>"
        ],
        [
          "(<Id>B_ExtraContent</Id>(?:(?!</Properties>)[\\s\\S])*?</Position>)",
          "$1\r\n<Show>false</Show>"
        ],
        [
          "(<Id>B_ExtraContent</Id>(?:(?!</Properties>)[\\s\\S])*?</Visual>)",
          "$1\r\n<Enabled>false</Enabled>"
        ],
        [
          "<NavUp>B_Singleplayer</NavUp>",
          "<NavUp>B_Quit</NavUp>"
        ],
        [
          "<NavTabBackward>B_Singleplayer</NavTabBackward>",
          "<NavTabBackward>B_Quit</NavTabBackward>"
        ],
        [
          "<NavDown>B_Test</NavDown>",
          "<NavDown>B_Multiplayer</NavDown>"
        ],
        [
          "<NavTabForward>B_Test</NavTabForward>",
          "<NavTabForward>B_Multiplayer</NavTabForward>"
        ],
        [
          "<NavDown>B_ExtraContent</NavDown>",
          "<NavDown>B_SelectProfile</NavDown>"
        ],
        [
          "<NavTabForward>B_ExtraContent</NavTabForward>",
          "<NavTabForward>B_SelectProfile</NavTabForward>"
        ],
        [
          "<NavUp>B_ExtraContent</NavUp>",
          "<NavUp>B_Credits</NavUp>"
        ],
        [
          "<NavTabBackward>B_ExtraContent</NavTabBackward>",
          "<NavTabBackward>B_Credits</NavTabBackward>"
        ],
        [
          "80\\.000008,556\\.000000",
          "80.000008,514.000000"
        ],
        [
          "80\\.000000,622\\.000000",
          "80.000000,580.000000"
        ]
      ]
    }
  ]
}
