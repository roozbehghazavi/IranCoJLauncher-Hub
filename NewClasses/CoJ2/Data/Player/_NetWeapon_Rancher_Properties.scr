!NetAmmo(s, i) // ammo type and amount of ammo pieces to be added
!NetWeapon(s) // weapon that player will receive on start in multiplayer game
!NetDefaultWeaponL(s) // weapon that player will have in left hand on start in multiplayer game
!NetDefaultWeaponR(s) // weapon that player will have in right hand on start in multiplayer game

// TEST: the hidden Rancher class carries two Colt Frontiers (Border Guns) and throwing knives (a clip of 5)
// two Border Guns like the Gunslinger's pair (and his 90 rounds)
NetDefaultWeaponR("WeaponPistolFrontierNet")
NetDefaultWeaponL("WeaponPistolFrontierNet")
NetWeapon("WeaponPistolFrontierNet")
NetWeapon("WeaponPistolFrontierNet")
NetAmmo("AmmoPistol", 90)
NetWeapon("WeaponPistolDerringerUpgradeNet")
