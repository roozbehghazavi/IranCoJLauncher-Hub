// Generated: ray coat with a user-colour slot so the team tint reaches the coat.
// Referenced only from the team skin variant.
import "templates.mtt"

sub material()
{
    use mtt_objects(
        s_clr = "ray_coat_team.dds",
        s_nrm = "ray_coat_nrm.dds",
        s_shn = "ray_coat_shn.dds",

        __clr_srf_a_msk = s_shn_a,
        s_clr_srf_a = "srf_fabric_leather_a.dds",
        __nrm_srf_a_msk = s_shn_a,
        s_nrm_srf_a = "srf_fabric_leather_a_nrm.dds",
        f_nrm_srf_a_scale = 0.3,

        b_clr_usr_on = TRUE,
        __clr_usr_msk = s_shn_a,

        f_shn_factor = 1.0,
        f_srf_uv_scale = 15.0
    );
}
