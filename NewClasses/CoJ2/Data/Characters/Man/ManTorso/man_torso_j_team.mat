// IranCoJ: PeasantA's shirt (man_torso_j) with the team tint on all of the cloth, not only the belt
// (stock: __clr_usr_msk = s_msk_g). Referenced only from the PeasantATeam skins (team modes).
import "templates.mtt"

sub material()
{
    use mtt_objects(
        s_clr = "man_torso_j.dds",
        s_shn = "man_torso_j_shn.dds",
        s_nrm = "man_torso_j_nrm.dds",
        s_msk = "man_torso_j_msk.dds",

        __clr_srf_msk = s_shn_a_inv,
        __nrm_srf_msk = s_shn_a_inv,
        s_clr_srf = "srf_fabric_cloth_b.dds",
        s_nrm_srf = "srf_fabric_cloth_b_nrm.dds",
        f_nrm_srf_scale = 1.0,

        __clr_srf_a_msk = s_shn_a,
        __nrm_srf_a_msk = s_shn_a,
        s_clr_srf_a = "srf_skin_hand_a.dds",
        s_nrm_srf_a = "srf_skin_hand_a_nrm.dds",
        f_nrm_srf_a_scale = 0.2,

        b_clr_usr_on = TRUE,
        __clr_usr_msk = s_shn_a_inv,

        f_srf_uv_scale = 18.0,
        f_shn_factor = 0.5
    );
}
