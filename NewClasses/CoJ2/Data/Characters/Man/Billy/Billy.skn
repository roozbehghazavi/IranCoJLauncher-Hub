// IranCoJ: Billy the Kid (CoJ Gunslinger) on the Man skeleton - skins for the Rifleman class
Skin("Default")
{
	!include("man_surfaces.skt")
}

Skin("Billy")
{
	!include("man_surfaces.skt")
	Hide("HolsterL")
	Hide("HolsterR")
}

Skin("Billy_player")
{
	FilterInEditor()
	!include("man_surfaces.skt")
	Replace("billy_head.mat", "man_null.mat")
	Replace("billy_eyes.mat", "man_null.mat")
	Replace("billy_teeth.mat", "man_null.mat")
	Replace("billy_hair.mat", "man_null.mat")
	Replace("billy_hat.mat", "man_null.mat")
	Replace("billy_hatband.mat", "man_null.mat")
	Hide("HolsterL")
	Hide("HolsterR")
}

