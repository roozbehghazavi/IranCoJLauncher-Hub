import "fx.mtt"

sub material()
{
    use mtt_fx(
        e_blend_mode = e_bm_mul,
        s_clr = "BloodWaterTrace.dds",
        b_dpt_write = FALSE,
        e_order = or_water_6,
        s_tech = s_tech_opq,
        e_type = e_type_fx_ws
    );
}
